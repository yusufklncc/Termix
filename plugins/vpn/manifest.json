{
  "id": "vpn",
  "name": "VPNs",
  "version": "1.1.0",
  "description": "Reach a host through a network Termix raises for it: a Fortinet gateway, a tailnet, a NetBird network.",
  "author": {
    "name": "Yusuf Ihsan Kilinc"
  },
  "license": "Apache-2.0",
  "category": "Networking",
  "icon": "Waypoints",
  "engine": {
    "termix": ">=26.11.2-0",
    "api": "^2.7.0"
  },
  "capabilities": [
    "db:own",
    "hosts:read",
    "network:outbound",
    "ui:surface",
    "network:serve",
    "network:sockets"
  ],
  "provides": [
    {
      "service": "host.gateway",
      "version": "1.0.0",
      "permission": "vpn.gateway"
    }
  ],
  "contributes": {
    "permissions": [
      {
        "name": "gateway",
        "titleKey": "permissions.gateway.title",
        "descriptionKey": "permissions.gateway.description",
        "defaultRoles": ["admin", "user"]
      }
    ],
    "panels": [
      {
        "id": "vpn",
        "titleKey": "nav.vpns",
        "icon": "Waypoints"
      }
    ],
    "settings": {
      "host": {
        "fields": [
          {
            "key": "profileId",
            "type": "number",
            "labelKey": "settings.host.profileId.label",
            "hidden": true,
            "min": 1,
            "defaultLevels": ["user", "folder"]
          },
          {
            "key": "profileName",
            "type": "string",
            "labelKey": "settings.host.profileName.label",
            "hidden": true,
            "defaultLevels": ["user", "folder"]
          }
        ]
      }
    }
  },
  "locales": "locales",
  "platforms": ["linux", "win32", "darwin"],
  "env": [
    {
      "name": "NET_MANAGER_URL",
      "description": "Where the network manager container listens, as tcp://host:port.",
      "default": "tcp://termix-netmgr:3392"
    },
    {
      "name": "NET_MANAGER_TOKEN",
      "description": "Shared secret with the network manager. Without it managed VPN profiles are not raised.",
      "secret": true
    },
    {
      "name": "NET_MANAGER_DOOR_BASE",
      "description": "First port of the per-profile SOCKS doors on the network manager; profile N listens on base + N.",
      "default": "20000"
    },
    {
      "name": "NET_MANAGER_SYNC_INTERVAL_MS",
      "description": "How often profiles are reconciled with the network manager, in milliseconds.",
      "default": "60000"
    }
  ],
  "sandbox": {
    "alwaysOn": true
  }
}
