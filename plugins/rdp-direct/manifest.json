{
  "id": "rdp-direct",
  "name": "Direct RDP",
  "version": "1.0.0",
  "description": "Reach an RDP host without guacd: the server's own H.264 frames are passed to the browser and decoded there.",
  "author": {
    "name": "Yusuf Ihsan Kilinc"
  },
  "license": "Apache-2.0",
  "category": "Terminal",
  "icon": "MonitorPlay",
  "engine": {
    "termix": ">=2.9.0",
    "api": "1"
  },
  "capabilities": [
    "hosts:read",
    "credentials:read",
    "credentials:use",
    "ssh:connect",
    "network:outbound",
    "network:serve",
    "ui:surface"
  ],
  "optionalDependencies": {
    "session-recording": "^1.0.0"
  },
  "requires": [
    {
      "service": "recordings.writer",
      "versionRange": "^1.1.0",
      "optional": true
    }
  ],
  "contributes": {
    "protocols": [
      {
        "id": "rdp-direct",
        "defaultPort": 3389,
        "credentialFields": [
          {
            "key": "domain"
          }
        ],
        "hostLoginFallback": ["username", "password"]
      }
    ],
    "tabs": [
      {
        "id": "rdp-direct",
        "titleKey": "tabs.rdpDirect",
        "icon": "MonitorPlay",
        "openFrom": ["host-context-menu", "palette"]
      }
    ],
    "settings": {
      "admin": [
        {
          "key": "bridgeUrl",
          "type": "string",
          "labelKey": "settings.admin.bridgeUrl.label",
          "descriptionKey": "settings.admin.bridgeUrl.description",
          "placeholderKey": "settings.admin.bridgeUrl.placeholder",
          "default": ""
        }
      ],
      "host": {
        "fields": [
          {
            "key": "enableRdpDirect",
            "type": "boolean",
            "labelKey": "settings.host.enable.label",
            "default": false,
            "hidden": true,
            "defaultable": false
          },
          {
            "key": "port",
            "type": "number",
            "labelKey": "settings.host.port.label",
            "descriptionKey": "settings.host.port.description",
            "requires": "enableRdpDirect",
            "min": 1,
            "max": 65535,
            "default": 3389
          },
          {
            "key": "enablePrinting",
            "type": "boolean",
            "labelKey": "settings.host.enablePrinting.label",
            "descriptionKey": "settings.host.enablePrinting.description",
            "requires": "enableRdpDirect",
            "default": false
          }
        ]
      }
    }
  },
  "locales": "locales",
  "platforms": ["linux", "win32", "darwin"]
}
